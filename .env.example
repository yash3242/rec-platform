# Copy to .env and replace placeholders before running locally.

DB_URL=jdbc:postgresql://localhost:5432/rec_platform
DB_USERNAME=rec_user
DB_PASSWORD=change-me-db-password

JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# Seed users (leave blank to skip seeding)
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=change-me-admin-password
APP_SEED_PRODUCER_EMAIL=producer@example.com
APP_SEED_PRODUCER_PASSWORD=change-me-producer-password
APP_SEED_REVIEWER_EMAIL=reviewer@example.com
APP_SEED_REVIEWER_PASSWORD=change-me-reviewer-password
APP_SEED_MANAGER_EMAIL=manager@example.com
APP_SEED_MANAGER_PASSWORD=change-me-manager-password
